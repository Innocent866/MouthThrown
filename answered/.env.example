# Public app URL (used in Stripe redirect + reminder emails)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Supabase — omit to run in local demo mode (drafts stay in localStorage)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Stripe — omit to disable checkout (or use DEMO_MODE)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Reminder emails (Resend) — cron route no-ops without it
RESEND_API_KEY=
REMINDER_FROM_EMAIL="Answered <reminders@yourdomain.com>"
CRON_SECRET=

# Set to "true" ONLY for local development/demos: skips real payment and
# unlocks the download. Never enable in production.
DEMO_MODE=
